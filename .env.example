# PostgreSQL (local Postgres, or Supabase: Project Settings > Database > Connection string)
DATABASE_URL=postgres://smartclinic:smartclinic@localhost:5432/smartclinic
# Set to "require" for Supabase / managed Postgres
PGSSL=disable
# Random 32+ char secret used to sign session cookies:  openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Public base URL used in patient tracking links
APP_URL=http://localhost:3000
# Web Push (optional):  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
